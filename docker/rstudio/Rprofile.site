# Setting default repo globally
home <- Sys.getenv("R_HOME")
.libPaths(c(file.path(home, "lib"), .libPaths()))

r_ver <- Sys.getenv("R_VERSION", unset = as.character(getRversion()))
r_minor <- sub("^([0-9]+\\.[0-9]+).*", "\\1", r_ver)
default_cran <- "https://nexus.ssb.no/repository/packagemanager-rstudio-resolute/"
legacy_posit_prefixes <- c(
  "https://packagemanager.posit.co/cran/__linux__/resolute",
  "https://p3m.dev/cran/__linux__/resolute"
)

cran <- Sys.getenv("CRAN", unset = default_cran)
if (any(startsWith(cran, legacy_posit_prefixes))) {
  cran <- default_cran
}
Sys.setenv(CRAN = cran)

options(repos = c(
  P3M = sprintf("https://nexus.ssb.no/repository/r-p3m/%s", r_minor),
  CRAN = cran
))
options(renv.config.repos.override = getOption("repos"))

# --- XLConnect: pek Java/JAR-hentingen mot intern Nexus (Maven-proxy) ---
# Merk: Dette er R-side env, satt tidlig i økten.
Sys.setenv(
  XLCONNECT_JAVA_REPO_URL = "https://nexus.ssb.no/repository/maven-public/"
)

# Deaktiver automatisk lagring av .RData og .Rhistory
if (interactive()) {
  Sys.setenv(R_HISTFILE = "/dev/null")  # Forhindrer lagring av .Rhistory
  options(save.workspace = "no")  # Hindrer lagring av .RData ved avslutning
  options(load.workspace = FALSE)  # Hindrer lasting av .RData ved oppstart
}
